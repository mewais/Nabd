{
  "name": "nabd",
  "version": "0.1.0",
  "private": true,
  "description": "Nabḍ — desk workout tracker & planner for remote workers",
  "author": "Mohammad Ewais <mohammad.a.ewais@gmail.com>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @nabd/app dev",
    "build": "pnpm --filter @nabd/app build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test --config e2e --trace off",
    "smoke:linux": "bash scripts/smoke/linux-smoke.sh",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -p nabd-persistence -p nabd-native -p nabd-ipc",
    "typecheck": "tsc -p .",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:rust": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "check": "pnpm lint && pnpm lint:rust && pnpm typecheck && pnpm test && pnpm test:rust"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.10.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^15.7.4",
    "playwright": "1.63.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
