{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nabd",
  "version": "../package.json",
  "identifier": "com.mewais.nabd",
  "build": {
    "frontendDist": "../packages/app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @nabd/app dev",
    "beforeBuildCommand": "pnpm --filter @nabd/app build"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
